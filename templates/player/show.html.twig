{% extends 'base.html.twig' %}
{% set fullscreen = true %}

{% block title %}{{ slideshow.name }} - Player{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background: #000;
        }
        
        /* Ensure YouTube overlay is truly fullscreen and above everything */
        #youtube-live-overlay {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            margin: 0 !important;
            padding: 0 !important;
            z-index: 999999 !important;
            background: #000 !important;
        }
        
        #youtube-live-overlay #youtube-live-player {
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 100% !important;
        }
    </style>
{% endblock %}

{% block body %}
<!-- YouTube Live Overlay - must be outside slideshow-player for proper z-index -->
<div id="youtube-live-overlay" class="youtube-live-overlay" style="display: none;">
    <div id="youtube-live-player"></div>
</div>

<div id="slideshow-player" class="slideshow-player" data-slideshow-id="{{ slideshow.id }}">
    <div class="slides-container">
        {% for slide in slideshow.slides %}
            <div class="slide {% if loop.first %}active{% endif %}" 
                 data-slide-id="{{ slide.id }}"
                 data-media-type="{{ slide.mediaType }}">
                {% if slide.isVideo %}
                    <video muted playsinline>
                        <source src="{{ asset('uploads/slides/' ~ slide.imagePath) }}" type="video/{{ slide.imagePath|split('.')|last }}">
                        Twoja przeglądarka nie obsługuje odtwarzania wideo.
                    </video>
                {% else %}
                    <img src="{{ asset('uploads/slides/' ~ slide.imagePath) }}" alt="{{ slideshow.name }} - Slide {{ loop.index }}">
                {% endif %}
            </div>
        {% endfor %}
    </div>

    <div class="player-controls">
        <div class="control-bar">
            <button id="prev-btn" class="control-btn" title="Poprzedni (←)">‹</button>
            <button id="play-pause-btn" class="control-btn" title="Odtwórz/Pauza (Spacja)">▶</button>
            <button id="next-btn" class="control-btn" title="Następny (→)">›</button>
            <div class="progress-container">
                <div class="progress-bar" id="progress-bar"></div>
            </div>
            <div class="slide-counter">
                <span id="current-slide">1</span> / <span id="total-slides">{{ slideshow.slides|length }}</span>
            </div>
            <button id="fullscreen-btn" class="control-btn" title="Pełny ekran (F)">⛶</button>
            <button id="close-btn" class="control-btn" title="Zamknij (ESC)">✕</button>
        </div>
    </div>

    <div class="player-info">
        <h2>{{ slideshow.name }}</h2>
        {% if slideshow.description %}
            <p>{{ slideshow.description }}</p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script>
        // Define YouTube API callback BEFORE loading the API script
        var youtubeApiReady = false;
        var youtubeApiReadyCallbacks = [];
        
        window.onYouTubeIframeAPIReady = function() {
            console.log('✅ YouTube IFrame API is now ready');
            youtubeApiReady = true;
            
            // Execute all pending callbacks
            youtubeApiReadyCallbacks.forEach(function(callback) {
                try {
                    callback();
                } catch (e) {
                    console.error('Error in YouTube ready callback:', e);
                }
            });
            youtubeApiReadyCallbacks = [];
        };
        
        // Helper function to ensure API is ready before executing
        function whenYouTubeReady(callback) {
            if (youtubeApiReady) {
                callback();
            } else {
                youtubeApiReadyCallbacks.push(callback);
            }
        }
    </script>
    
    <!-- YouTube IFrame API - loaded AFTER defining the callback -->
    <script src="https://www.youtube.com/iframe_api"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Player script loaded');
            
            const SLIDE_DURATION = 5000; // 5 sekund
        const MERCURE_TOPIC = '{{ mercureTopic }}';
        const MERCURE_YOUTUBE_TOPIC = 'slideshow/{{ slideshow.id }}/youtube';
        const MERCURE_URL = '/.well-known/mercure';
        const SLIDESHOW_ID = {{ slideshow.id }};
        
        let currentSlide = 0;
        let isPlaying = false;
        let slideInterval = null;
        let progressInterval = null;
        let progressWidth = 0;
        let currentVideoEndedListener = null;
        let youtubeLivePlayer = null; // Live YouTube player
        let wasPlayingBeforeYoutube = false;
        let pendingYoutubeVideo = null; // Queue for YouTube video if API not ready

        let slides = document.querySelectorAll('.slide');
        let totalSlides = slides.length;
        
        console.log('Total slides:', totalSlides);
        console.log('Slides found:', slides);
        const playPauseBtn = document.getElementById('play-pause-btn');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const fullscreenBtn = document.getElementById('fullscreen-btn');
        const closeBtn = document.getElementById('close-btn');
        const progressBar = document.getElementById('progress-bar');
        const currentSlideSpan = document.getElementById('current-slide');
        const playerControls = document.querySelector('.player-controls');
        const playerInfo = document.querySelector('.player-info');
        
        if (!playPauseBtn) console.error('Play button not found!');
        if (totalSlides === 0) {
            console.error('No slides found!');
            alert('Brak slajdów do wyświetlenia');
        }

        function showSlide(index) {
            // Clear any existing video listener
            if (currentVideoEndedListener) {
                currentVideoEndedListener.removeEventListener('ended', handleVideoEnded);
                currentVideoEndedListener = null;
            }
            
            // Clear any existing intervals
            clearInterval(slideInterval);
            clearInterval(progressInterval);
            slideInterval = null;
            progressInterval = null;
            
            slides.forEach((slide, i) => {
                const isActive = i === index;
                slide.classList.toggle('active', isActive);
                
                const mediaType = slide.dataset.mediaType;
                const slideId = slide.dataset.slideId;
                
                // Handle video playback
                const video = slide.querySelector('video');
                if (video) {
                    if (isActive) {
                        video.currentTime = 0;
                        video.play();
                    } else {
                        video.pause();
                    }
                }
            });
            currentSlide = index;
            currentSlideSpan.textContent = index + 1;
            resetProgress();
            
            // If playing, set up timer for next slide
            if (isPlaying) {
                const currentSlideElement = slides[index];
                const mediaType = currentSlideElement.dataset.mediaType;
                const slideId = currentSlideElement.dataset.slideId;
                const video = currentSlideElement.querySelector('video');
                
                if (video) {
                    // For videos: wait for video to end
                    currentVideoEndedListener = video;
                    video.addEventListener('ended', handleVideoEnded);
                    
                    // Progress bar based on video duration
                    progressInterval = setInterval(() => {
                        if (video.duration > 0) {
                            progressWidth = (video.currentTime / video.duration) * 100;
                            progressBar.style.width = progressWidth + '%';
                        }
                    }, 50);
                } else {
                    // For images: use fixed duration
                    slideInterval = setInterval(nextSlide, SLIDE_DURATION);
                    progressInterval = setInterval(updateProgress, 50);
                }
            }
        }
        
        function handleVideoEnded() {
            if (isPlaying) {
                nextSlide();
            }
        }

        function nextSlide() {
            const next = (currentSlide + 1) % totalSlides;
            showSlide(next);
        }

        function prevSlide() {
            const prev = (currentSlide - 1 + totalSlides) % totalSlides;
            showSlide(prev);
        }

        function resetProgress() {
            progressWidth = 0;
            progressBar.style.width = '0%';
        }

        function updateProgress() {
            progressWidth += (100 / (SLIDE_DURATION / 50));
            if (progressWidth >= 100) {
                progressWidth = 100;
            }
            progressBar.style.width = progressWidth + '%';
        }

        function play() {
            console.log('Play function called');
            if (isPlaying) {
                console.log('Already playing, returning');
                return;
            }
            isPlaying = true;
            playPauseBtn.textContent = '❚❚';
            
            // Trigger showSlide to set up appropriate timer/listener
            showSlide(currentSlide);
            
            console.log('Playback started');
        }

        function pause() {
            if (!isPlaying) return;
            isPlaying = false;
            playPauseBtn.textContent = '▶';
            clearInterval(slideInterval);
            clearInterval(progressInterval);
            
            // Remove video listener if exists
            if (currentVideoEndedListener) {
                currentVideoEndedListener.removeEventListener('ended', handleVideoEnded);
                currentVideoEndedListener = null;
            }
            
            // Pause current video if any
            const currentSlideElement = slides[currentSlide];
            if (currentSlideElement) {
                const video = currentSlideElement.querySelector('video');
                if (video) {
                    video.pause();
                }
            }
        }

        function togglePlayPause() {
            if (isPlaying) {
                pause();
            } else {
                play();
            }
        }

        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen();
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        // Event listeners
        playPauseBtn.addEventListener('click', togglePlayPause);
        nextBtn.addEventListener('click', () => {
            pause();
            nextSlide();
        });
        prevBtn.addEventListener('click', () => {
            pause();
            prevSlide();
        });
        fullscreenBtn.addEventListener('click', toggleFullscreen);
        closeBtn.addEventListener('click', () => {
            window.close();
            if (window.opener) {
                window.opener.focus();
            }
        });

        // Keyboard controls
        document.addEventListener('keydown', (e) => {
            switch(e.key) {
                case 'ArrowLeft':
                    pause();
                    prevSlide();
                    break;
                case 'ArrowRight':
                    pause();
                    nextSlide();
                    break;
                case ' ':
                    e.preventDefault();
                    togglePlayPause();
                    break;
                case 'Escape':
                    if (document.fullscreenElement) {
                        document.exitFullscreen();
                    } else {
                        window.close();
                    }
                    break;
                case 'f':
                case 'F':
                    toggleFullscreen();
                    break;
            }
        });

        // Auto-hide controls
        let hideTimeout;
        document.addEventListener('mousemove', () => {
            playerControls.style.opacity = '1';
            playerInfo.style.opacity = '1';
            clearTimeout(hideTimeout);
            hideTimeout = setTimeout(() => {
                if (isPlaying) {
                    playerControls.style.opacity = '0';
                    playerInfo.style.opacity = '0';
                }
            }, 3000);
        });

            // Auto-start
            setTimeout(() => play(), 500);

            // Initialize Mercure connection for live updates
            function initializeMercure() {
                const url = new URL(MERCURE_URL, window.location.origin);
                url.searchParams.append('topic', MERCURE_TOPIC);

                console.log('Connecting to Mercure:', url.toString());

                const eventSource = new EventSource(url);

                eventSource.onopen = () => {
                    console.log('✅ Mercure connection established');
                };

                eventSource.onmessage = (event) => {
                    console.log('📨 Mercure update received:', event.data);
                    
                    try {
                        const data = JSON.parse(event.data);
                        handleSlideshowUpdate(data);
                    } catch (error) {
                        console.error('Error parsing Mercure data:', error);
                    }
                };

                eventSource.onerror = (error) => {
                    console.error('❌ Mercure connection error:', error);
                    // EventSource will automatically reconnect
                };

                // Close connection when leaving page
                window.addEventListener('beforeunload', () => {
                    eventSource.close();
                });
            }

            function handleSlideshowUpdate(data) {
                console.log('🔄 Handling slideshow update:', data.action);
                console.log('📊 Slideshow ID match:', data.slideshowId, '===', SLIDESHOW_ID, '?', data.slideshowId === SLIDESHOW_ID);
                console.log('📦 All slides:', data.allSlides);
                
                if (data.slideshowId !== SLIDESHOW_ID) {
                    console.log('⚠️ Ignoring update for different slideshow');
                    return; // Update is for different slideshow
                }

                console.log('✅ Processing update for current slideshow');

                switch (data.action) {
                    case 'slide_added':
                    case 'slide_removed':
                    case 'slide_updated':
                        // Rebuild entire slideshow with new data
                        console.log('🔨 Calling rebuildSlideshow with', data.allSlides.length, 'slides');
                        rebuildSlideshow(data.allSlides);
                        break;
                }
            }

            function rebuildSlideshow(newSlides) {
            const slidesContainer = document.querySelector('.slides-container');
            const wasPlaying = isPlaying;
            const currentIndex = currentSlide;
            
            // Pause if playing
            if (wasPlaying) {
                pause();
            }

            // Clear existing YouTube players
            for (let slideId in youtubePlayers) {
                if (youtubePlayers[slideId] && youtubePlayers[slideId].destroy) {
                    youtubePlayers[slideId].destroy();
                }
            }
            youtubePlayers = {};

            // Clear existing slides
            slidesContainer.innerHTML = '';

            // Create new slides
            newSlides.forEach((slideData, index) => {
                const slideDiv = document.createElement('div');
                slideDiv.className = 'slide';
                slideDiv.dataset.slideId = slideData.id;
                slideDiv.dataset.mediaType = slideData.mediaType;
                
                if (slideData.mediaType === 'video') {
                    const video = document.createElement('video');
                    video.autoplay = false;
                    video.muted = true;
                    video.playsInline = true;
                    
                    const source = document.createElement('source');
                    source.src = `/uploads/slides/${slideData.imagePath}`;
                    const extension = slideData.imagePath.split('.').pop();
                    source.type = `video/${extension}`;
                    
                    video.appendChild(source);
                    slideDiv.appendChild(video);
                } else {
                    const img = document.createElement('img');
                    img.src = `/uploads/slides/${slideData.imagePath}`;
                    img.alt = `Slide ${index + 1}`;
                    
                    slideDiv.appendChild(img);
                }
                
                slidesContainer.appendChild(slideDiv);
            });

            // Update global slides reference
            slides = document.querySelectorAll('.slide');
            totalSlides = slides.length;
            
            // Update counter
            document.getElementById('total-slides').textContent = totalSlides;

            // Adjust current slide index if needed
            if (currentIndex >= totalSlides) {
                currentSlide = Math.max(0, totalSlides - 1);
            } else {
                currentSlide = currentIndex;
            }

            // Show current slide
            showSlide(currentSlide);

            // Resume playing if it was playing
            if (wasPlaying && totalSlides > 0) {
                setTimeout(() => play(), 100);
            }

            console.log(`✨ Slideshow rebuilt with ${totalSlides} slides`);
        }
        
        // YouTube Live Control Functions
        function playYoutubeLive(videoId) {
            console.log('📺 Requested to play YouTube:', videoId);
            
            const overlay = document.getElementById('youtube-live-overlay');
            
            if (!window.youtubeApiReady) {
                console.warn('⏳ YouTube API not ready yet, queuing video...');
                pendingYoutubeVideo = videoId;
                
                // Show loading message
                overlay.style.display = 'flex';
                overlay.innerHTML = '<div style="color: white; font-size: 24px; text-align: center;"><div style="margin-bottom: 20px;">⏳</div>Ładowanie YouTube API...<br><small style="font-size: 14px; opacity: 0.7; margin-top: 10px; display: block;">Czekam na gotowość API...</small></div>';
                
                // Use the helper function to wait for API
                window.whenYouTubeReady(function() {
                    console.log('🎬 API ready, now playing queued video:', pendingYoutubeVideo);
                    if (pendingYoutubeVideo) {
                        const queuedVideoId = pendingYoutubeVideo;
                        pendingYoutubeVideo = null;
                        playYoutubeLive(queuedVideoId);
                    }
                });
                
                return;
            }

            console.log('▶️ Playing YouTube Live:', videoId);

            // Remember if slideshow was playing
            wasPlayingBeforeYoutube = isPlaying;
            
            // Pause slideshow
            if (isPlaying) {
                pause();
            }

            // Show YouTube overlay
            overlay.innerHTML = '<div id="youtube-live-player"></div>'; // Reset content
            overlay.style.display = 'flex';

            // Always create new player (clean slate approach)
            if (youtubeLivePlayer) {
                try {
                    if (typeof youtubeLivePlayer.destroy === 'function') {
                        youtubeLivePlayer.destroy();
                    }
                } catch (e) {
                    console.warn('Could not destroy old player:', e);
                }
                youtubeLivePlayer = null;
            }

            // Create fresh player instance
            try {
                youtubeLivePlayer = new YT.Player('youtube-live-player', {
                    height: '100%',
                    width: '100%',
                    videoId: videoId,
                    playerVars: {
                        'autoplay': 1,
                        'mute': 1,  // MUST be muted for autoplay to work in browsers
                        'controls': 1,
                        'modestbranding': 1,
                        'rel': 0,
                        'fs': 1,
                        'playsinline': 1,
                    },
                    events: {
                        'onError': function(event) {
                            console.error('YouTube player error:', event.data);
                        },
                        'onReady': function(event) {
                            console.log('YouTube player ready, starting playback...');
                            // Explicitly start playback when ready
                            event.target.unMute(); // Unmute after starting
                            event.target.playVideo();
                        },
                        'onStateChange': function(event) {
                            // When video actually starts playing, unmute it
                            if (event.data === YT.PlayerState.PLAYING) {
                                console.log('YouTube video is playing');
                                // Try to unmute (user may need to interact first due to browser policies)
                                try {
                                    event.target.unMute();
                                } catch (e) {
                                    console.warn('Could not unmute automatically:', e);
                                }
                            }
                        }
                    }
                });
            } catch (e) {
                console.error('Failed to create YouTube player:', e);
                overlay.innerHTML = '<div style="color: white; font-size: 24px; text-align: center;">❌<br>Błąd ładowania YouTube</div>';
            }
        }

        function stopYoutubeLive() {
            console.log('⏹️ Stopping YouTube Live');
            
            // Clear any pending video
            pendingYoutubeVideo = null;
            
            // Hide overlay first (immediate visual feedback)
            const overlay = document.getElementById('youtube-live-overlay');
            overlay.style.display = 'none';

            // Stop and destroy YouTube player (with error handling)
            if (youtubeLivePlayer) {
                try {
                    if (typeof youtubeLivePlayer.stopVideo === 'function') {
                        youtubeLivePlayer.stopVideo();
                    }
                } catch (e) {
                    console.warn('Could not stop player:', e);
                }
                
                try {
                    if (typeof youtubeLivePlayer.destroy === 'function') {
                        youtubeLivePlayer.destroy();
                    }
                } catch (e) {
                    console.warn('Could not destroy player:', e);
                }
                
                youtubeLivePlayer = null;
            }

            // Resume slideshow if it was playing
            if (wasPlayingBeforeYoutube) {
                setTimeout(() => play(), 100);
            }
        }

        // Initialize Mercure for YouTube control
        function initializeMercureYoutube() {
            const url = new URL(MERCURE_URL, window.location.origin);
            url.searchParams.append('topic', MERCURE_YOUTUBE_TOPIC);

            console.log('Connecting to Mercure YouTube:', url.toString());

            const eventSource = new EventSource(url);

            eventSource.onopen = () => {
                console.log('✅ Mercure YouTube connection established');
            };

            eventSource.onmessage = (event) => {
                console.log('📨 Mercure YouTube update received:', event.data);
                
                try {
                    const data = JSON.parse(event.data);
                    if (data.action === 'play' && data.videoId) {
                        playYoutubeLive(data.videoId);
                    } else if (data.action === 'stop') {
                        stopYoutubeLive();
                    }
                } catch (error) {
                    console.error('Error parsing Mercure YouTube data:', error);
                }
            };

            eventSource.onerror = (error) => {
                console.error('❌ Mercure YouTube connection error:', error);
            };

            window.addEventListener('beforeunload', () => {
                eventSource.close();
            });
        }
        
        // Initialize Mercure
        initializeMercure();
        initializeMercureYoutube();
        
    }); // end DOMContentLoaded
    </script>
{% endblock %}
