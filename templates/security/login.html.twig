{% extends 'base.html.twig' %}

{% block title %}{{ 'auth.login'|trans }} - CreativeSlajd{% endblock %}

{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <img src="{{ asset('images/cs-logo.png') }}" alt="CS Logo" class="auth-logo">
            <h1><span class="brand-creative">Creative</span><span class="brand-slajd">Slajd</span></h1>
            <p class="auth-subtitle">{{ 'auth.login_subtitle'|trans }}</p>
        </div>

        {% if error %}
            <div class="alert alert-error">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <div class="form-group">
                <label for="username">{{ 'auth.email'|trans }}</label>
                <input type="email" 
                       value="{{ last_username }}" 
                       name="_username" 
                       id="username" 
                       class="form-control" 
                       autocomplete="email" 
                       placeholder="{{ 'auth.email_placeholder'|trans }}"
                       required 
                       autofocus>
            </div>

            <div class="form-group">
                <label for="password">{{ 'auth.password'|trans }}</label>
                <input type="password" 
                       name="_password" 
                       id="password" 
                       class="form-control" 
                       autocomplete="current-password" 
                       placeholder="••••••••"
                       required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn btn-primary btn-block btn-lg">{{ 'auth.login'|trans }}</button>
        </form>

        <div class="auth-footer">
            <p>{{ 'auth.no_account'|trans }} <a href="{{ path('app_register') }}" class="auth-link">{{ 'auth.register'|trans }}</a></p>
        </div>
    </div>
</div>
{% endblock %}
