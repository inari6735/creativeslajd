# ============================================
# CreativeSlajd - Local Docker Environment
# ============================================
# Ten plik jest dla lokalnego testowania Docker (bez prawdziwej domeny)
# Skopiuj jako .env.production dla testów lokalnych

APP_ENV=prod
APP_SECRET=test-secret-key-change-in-production-use-openssl-rand-hex-32

# Localhost - nie będzie prawdziwego HTTPS, tylko HTTP
DOMAIN=localhost
CADDY_EMAIL=test@localhost
HTTP_PORT=8080
HTTPS_PORT=8443

LOG_LEVEL=DEBUG

# Baza danych
DB_NAME=creativeslajd
DB_USER=creativeslajd
DB_PASSWORD=test123
DB_VERSION=16

# PHP
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=10M

# Locale
DEFAULT_LOCALE=pl

# Mailer
MAILER_DSN=null://null
