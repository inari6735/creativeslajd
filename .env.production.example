# ============================================
# CreativeSlajd - Production Environment
# ============================================
# Skopiuj ten plik jako .env.production i wypełnij swoimi wartościami

# --------------------------------------------
# Aplikacja Symfony
# --------------------------------------------
APP_ENV=prod
# Wygeneruj silny klucz: openssl rand -hex 32
APP_SECRET=your-secret-key-here-generate-with-openssl-rand-hex-32

# --------------------------------------------
# Domena i HTTPS (Caddy)
# --------------------------------------------
# Twoja domena (bez http:// lub https://)
# WAŻNE: Musi być prawidłowa domena wskazująca na Twój serwer dla Let's Encrypt
DOMAIN=example.com

# Email dla powiadomień Let's Encrypt (odnowienie certyfikatów)
CADDY_EMAIL=admin@example.com

# Porty (domyślnie 80 i 443)
HTTP_PORT=80
HTTPS_PORT=443

# Poziom logowania Caddy (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# --------------------------------------------
# Baza danych PostgreSQL
# --------------------------------------------
DB_NAME=creativeslajd
DB_USER=creativeslajd_user
# Wygeneruj silne hasło: openssl rand -base64 32
DB_PASSWORD=your-strong-database-password-here
DB_VERSION=16

# --------------------------------------------
# Ustawienia PHP
# --------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=10M

# --------------------------------------------
# Locale (domyślny język aplikacji)
# --------------------------------------------
# Opcje: pl, en, de
DEFAULT_LOCALE=pl

# --------------------------------------------
# Mailer (opcjonalnie - do wysyłania emaili)
# --------------------------------------------
# null://null - wyłączone
# smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null

# --------------------------------------------
# Backup (opcjonalnie)
# --------------------------------------------
# Katalog dla backupów (poza kontenerem)
# BACKUP_PATH=/path/to/backups
