{% extends 'layout.html.twig' %}

{% block title %}Edycja: {{ slideshow.name }}{% endblock %}

{% block content %}
<div class="page-header">
    <h1>Edytuj pokaz: {{ slideshow.name }}</h1>
    <div class="edit-button-container">
        {% if slideshow.slides|length > 0 %}
            <a href="{{ path('app_player_show', {id: slideshow.id}) }}" class="btn btn-primary" target="_blank">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                Odtwórz pokaz
            </a>
        {% endif %}
        <a href="{{ path('app_slideshow_index') }}" class="btn btn-secondary">← Powrót do listy</a>
    </div>
</div>

<div class="edit-grid">
    <div class="edit-form">
        <h2>Informacje o pokazie</h2>
        {{ form_start(form, {'attr': {'class': 'slideshow-form'}}) }}
            <div class="form-group">
                {{ form_label(form.name) }}
                {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-group form-checkbox">
                {{ form_widget(form.isPublic) }}
                {{ form_label(form.isPublic) }}
                {{ form_errors(form.isPublic) }}
                {% if form.isPublic.vars.help %}
                    <small class="form-help">{{ form.isPublic.vars.help }}</small>
                {% endif %}
            </div>

            {% if slideshow.isPublic %}
                <div class="share-link-container">
                    <label>Link publiczny:</label>
                    <div class="share-link-group">
                        <input type="text" 
                               id="shareLink" 
                               class="form-control" 
                               value="{{ url('app_public_player_show', {shareToken: slideshow.shareToken}) }}" 
                               readonly>
                        <button type="button" class="btn btn-secondary" id="copyLinkBtn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                            Kopiuj
                        </button>
                    </div>
                    <small class="share-help">Ten link można udostępnić każdemu – nie wymaga logowania</small>
                </div>
            {% endif %}

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
            </div>
        {{ form_end(form) }}
    </div>

    <div class="slides-manager">
        <h2>Slajdy ({{ slideshow.slides|length }})</h2>

        <form method="post" action="{{ path('app_slide_upload', {id: slideshow.id}) }}" enctype="multipart/form-data" class="upload-form">
            <input type="hidden" name="_token" value="{{ csrf_token('upload' ~ slideshow.id) }}">
            <div class="upload-area">
                <input type="file" name="images[]" id="images" multiple accept="image/*" class="file-input">
                <label for="images" class="upload-label" id="upload-label">
                    <div class="upload-icon">📤</div>
                    <div class="upload-text">Kliknij lub przeciągnij zdjęcia tutaj</div>
                    <small>JPG, PNG, GIF (max 10MB)</small>
                </label>
            </div>
            <div id="selected-files" class="selected-files" style="display: none;"></div>
            <button type="submit" class="btn btn-primary btn-block">Dodaj zdjęcia</button>
        </form>

        {% if slideshow.slides|length > 0 %}
            <div class="slides-grid" id="slides-grid" data-slideshow-id="{{ slideshow.id }}">
                {% for slide in slideshow.slides %}
                    <div class="slide-item" data-slide-id="{{ slide.id }}" draggable="true">
                        <div class="slide-handle">⋮⋮</div>
                        <img src="{{ asset('uploads/slides/' ~ slide.imagePath) }}" alt="Slide {{ loop.index }}">
                        <div class="slide-overlay">
                            <span class="slide-number">#{{ loop.index }}</span>
                            <form method="post" action="{{ path('app_slide_delete', {id: slide.id}) }}" onsubmit="return confirm('Czy na pewno chcesz usunąć ten slajd?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ slide.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state-small">
                <p>Brak slajdów. Dodaj pierwsze zdjęcia do pokazu.</p>
            </div>
        {% endif %}
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/drag-drop.js') }}" defer></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const copyBtn = document.getElementById('copyLinkBtn');
            if (copyBtn) {
                copyBtn.addEventListener('click', function() {
                    const shareLink = document.getElementById('shareLink');
                    shareLink.select();
                    shareLink.setSelectionRange(0, 99999); // For mobile devices
                    
                    navigator.clipboard.writeText(shareLink.value).then(function() {
                        // Zmień tekst przycisku na chwilę
                        const originalText = copyBtn.innerHTML;
                        copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Skopiowano!';
                        copyBtn.classList.add('btn-success');
                        copyBtn.classList.remove('btn-secondary');
                        
                        setTimeout(function() {
                            copyBtn.innerHTML = originalText;
                            copyBtn.classList.remove('btn-success');
                            copyBtn.classList.add('btn-secondary');
                        }, 2000);
                    }).catch(function(err) {
                        console.error('Błąd kopiowania: ', err);
                        alert('Nie udało się skopiować linku');
                    });
                });
            }
        });
    </script>
{% endblock %}
