{% extends 'layout.html.twig' %}

{% block title %}{{ 'slideshow.edit_title'|trans }}: {{ slideshow.name }}{% endblock %}

{% block content %}
<div class="page-header">
    <h1>{{ 'slideshow.edit_title'|trans }}: {{ slideshow.name }}</h1>
    <div class="edit-button-container">
        {% if slideshow.slides|length > 0 %}
            <a href="{{ path('app_player_show', {id: slideshow.id}) }}" class="btn btn-primary" target="_blank">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                {{ 'slides.play_button'|trans }}
            </a>
        {% endif %}
        <a href="{{ path('app_slideshow_index') }}" class="btn btn-secondary">← {{ 'nav.back'|trans }}</a>
    </div>
</div>

<div class="edit-grid">
    <div class="edit-form">
        <h2>{{ 'slideshow.info'|trans }}</h2>
        {{ form_start(form, {'attr': {'class': 'slideshow-form'}}) }}
            <div class="form-group">
                {{ form_label(form.name) }}
                {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-group form-checkbox">
                {{ form_widget(form.isPublic) }}
                {{ form_label(form.isPublic) }}
                {{ form_errors(form.isPublic) }}
                {% if form.isPublic.vars.help %}
                    <small class="form-help">{{ form.isPublic.vars.help }}</small>
                {% endif %}
            </div>

            <div class="form-group form-checkbox">
                {{ form_widget(form.isPubliclyEditable) }}
                {{ form_label(form.isPubliclyEditable) }}
                {{ form_errors(form.isPubliclyEditable) }}
                {% if form.isPubliclyEditable.vars.help %}
                    <small class="form-help">{{ form.isPubliclyEditable.vars.help }}</small>
                {% endif %}
            </div>

            {% if slideshow.isPublic %}
                <div class="share-link-container" data-controller="clipboard">
                    <label>{{ 'share.public_link'|trans }}:</label>
                    <div class="share-link-group">
                        <input type="text" 
                               class="form-control" 
                               value="{{ url('app_public_player_show', {shareToken: slideshow.shareToken}) }}" 
                               data-clipboard-target="source"
                               readonly>
                        <button type="button" 
                                class="btn btn-secondary" 
                                data-clipboard-target="button"
                                data-action="click->clipboard#copy">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                            {{ 'share.copy'|trans }}
                        </button>
                    </div>
                    <small class="share-help">{{ 'share.public_help'|trans }}</small>
                </div>
            {% endif %}

            {% if slideshow.isPubliclyEditable %}
                <div class="share-link-container" data-controller="clipboard" style="margin-top: var(--space-md); border-color: var(--warning);">
                    <label>{{ 'share.edit_link'|trans }}:</label>
                    <div class="share-link-group">
                        <input type="text" 
                               class="form-control" 
                               value="{{ url('app_public_edit_show', {editToken: slideshow.editToken}) }}" 
                               data-clipboard-target="source"
                               readonly>
                        <button type="button" 
                                class="btn btn-secondary" 
                                data-clipboard-target="button"
                                data-action="click->clipboard#copy">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                            {{ 'share.copy'|trans }}
                        </button>
                    </div>
                    <small class="share-help" style="color: var(--warning);"><strong>⚠️ {{ 'share.warning'|trans }}:</strong> {{ 'share.edit_help'|trans }}</small>
                </div>
            {% endif %}

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">{{ 'form.save'|trans }}</button>
            </div>
        {{ form_end(form) }}
    </div>

    <div class="slides-manager">
        <h2>{{ 'slides.title'|trans }} ({{ slideshow.slides|length }})</h2>

        {# YouTube Live Player Section #}
        <div class="youtube-live-section">
            <h3>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#ff0000"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                {{ 'slides.youtube_live'|trans }}
            </h3>
            <div class="youtube-live-controls">
                <div class="form-group" style="flex: 1; margin: 0;">
                    <input type="url" 
                           id="youtube_live_url"
                           class="form-control"
                           placeholder="https://www.youtube.com/watch?v=...">
                </div>
                <button type="button" id="youtube-play-btn" class="btn btn-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    {{ 'slides.youtube_play'|trans }}
                </button>
                <button type="button" id="youtube-stop-btn" class="btn btn-danger" style="display: none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect></svg>
                    {{ 'slides.youtube_stop'|trans }}
                </button>
            </div>
            <small class="form-help">{{ 'slides.youtube_live_help'|trans }}</small>
        </div>

        <div class="upload-divider">
            <span>{{ 'slides.upload_section'|trans }}</span>
        </div>

        <form method="post" 
              action="{{ path('app_slide_upload', {id: slideshow.id}) }}" 
              enctype="multipart/form-data" 
              class="upload-form"
              data-controller="file-upload">
            <input type="hidden" name="_token" value="{{ csrf_token('upload' ~ slideshow.id) }}">
            
            <div class="upload-area">
                <input type="file" 
                       name="images[]" 
                       id="images"
                       multiple 
                       accept="image/*,video/*" 
                       class="file-input"
                       data-file-upload-target="input"
                       data-action="change->file-upload#change">
                <label for="images"
                       class="upload-label" 
                       data-file-upload-target="label"
                       data-action="dragenter->file-upload#dragEnter dragover->file-upload#dragOver dragleave->file-upload#dragLeave drop->file-upload#drop">
                    <div class="upload-icon">📤</div>
                    <div class="upload-text" data-file-upload-target="labelText">{{ 'slides.drop_here'|trans }}</div>
                    <small>{{ 'slides.file_types_media'|trans({'%default%': 'slides.file_types'|trans}) }}</small>
                </label>
            </div>
            <div class="selected-files" style="display: none;" data-file-upload-target="filesList"></div>
            <button type="submit" class="btn btn-primary btn-block">{{ 'slides.add_button'|trans }}</button>
        </form>

        {% if slideshow.slides|length > 0 %}
            <div class="slides-grid" 
                 data-controller="drag-drop" 
                 data-drag-drop-slideshow-id-value="{{ slideshow.id }}"
                 data-action="dragover->drag-drop#dragOver drop->drag-drop#drop">
                {% for slide in slideshow.slides %}
                    <div class="slide-item" 
                         data-slide-id="{{ slide.id }}" 
                         data-media-type="{{ slide.mediaType }}"
                         draggable="true"
                         data-action="dragstart->drag-drop#dragStart dragend->drag-drop#dragEnd">
                        <div class="slide-handle">⋮⋮</div>
                        {% if slide.isVideo %}
                            <video muted>
                                <source src="{{ asset('uploads/slides/' ~ slide.imagePath) }}" type="video/{{ slide.imagePath|split('.')|last }}">
                            </video>
                            <div class="media-badge">🎬 Video</div>
                        {% else %}
                            <img src="{{ asset('uploads/slides/' ~ slide.imagePath) }}" alt="Slide {{ loop.index }}">
                        {% endif %}
                        <div class="slide-overlay">
                            <span class="slide-number">#{{ loop.index }}</span>
                            <form method="post" action="{{ path('app_slide_delete', {id: slide.id}) }}" onsubmit="return confirm('{{ 'slides.delete_confirm'|trans|escape('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ slide.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state-small">
                <p>{{ 'slides.no_slides'|trans }}</p>
            </div>
        {% endif %}
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const youtubeUrlInput = document.getElementById('youtube_live_url');
            const playBtn = document.getElementById('youtube-play-btn');
            const stopBtn = document.getElementById('youtube-stop-btn');
            const slideshowId = {{ slideshow.id }};
            const mercureUrl = '/.well-known/mercure';
            const mercureYoutubeTopic = 'slideshow/' + slideshowId + '/youtube';
            const mercureSlideshowTopic = 'slideshow/' + slideshowId;

            // Initialize Mercure for slideshow updates
            initializeMercureSlideshow();

            if (playBtn) {
                playBtn.addEventListener('click', function() {
                    const url = youtubeUrlInput.value.trim();
                    if (!url) {
                        alert('{{ 'slides.youtube_empty'|trans }}');
                        return;
                    }

                    // Extract YouTube video ID
                    const videoId = extractYoutubeId(url);
                    if (!videoId) {
                        alert('{{ 'slides.youtube_invalid'|trans }}');
                        return;
                    }

                    // Publish to Mercure to start YouTube on all players
                    publishYoutubeAction('play', videoId);

                    // Update UI
                    playBtn.style.display = 'none';
                    stopBtn.style.display = 'inline-flex';
                });
            }

            if (stopBtn) {
                stopBtn.addEventListener('click', function() {
                    // Publish to Mercure to stop YouTube on all players
                    publishYoutubeAction('stop', null);

                    // Update UI
                    stopBtn.style.display = 'none';
                    playBtn.style.display = 'inline-flex';
                });
            }

            function extractYoutubeId(url) {
                const patterns = [
                    /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/,
                ];
                
                for (let pattern of patterns) {
                    const match = url.match(pattern);
                    if (match) {
                        return match[1];
                    }
                }
                return null;
            }

            function publishYoutubeAction(action, videoId) {
                const data = {
                    action: action,
                    videoId: videoId,
                    slideshowId: slideshowId,
                    timestamp: Date.now()
                };

                // Send via fetch to a custom endpoint
                fetch('{{ path('app_slideshow_youtube_control', {id: slideshow.id}) }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        console.log('YouTube control sent:', action);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('{{ 'slides.youtube_error'|trans }}');
                });
            }

            // Mercure for live slideshow updates
            function initializeMercureSlideshow() {
                const url = new URL(mercureUrl, window.location.origin);
                url.searchParams.append('topic', mercureSlideshowTopic);

                console.log('Connecting to Mercure for slideshow updates:', url.toString());

                const eventSource = new EventSource(url);

                eventSource.onopen = () => {
                    console.log('✅ Mercure slideshow connection established');
                };

                eventSource.onmessage = (event) => {
                    console.log('📨 Mercure slideshow update received:', event.data);
                    
                    try {
                        const data = JSON.parse(event.data);
                        handleSlideshowUpdate(data);
                    } catch (error) {
                        console.error('Error parsing Mercure data:', error);
                    }
                };

                eventSource.onerror = (error) => {
                    console.error('❌ Mercure slideshow connection error:', error);
                };

                window.addEventListener('beforeunload', () => {
                    eventSource.close();
                });
            }

            function handleSlideshowUpdate(data) {
                console.log('🔄 Handling slideshow update:', data.action);
                
                if (data.slideshowId !== slideshowId) {
                    console.log('⚠️ Ignoring update for different slideshow');
                    return;
                }

                console.log('✅ Update for current slideshow - reloading page');
                
                // Simply reload the page to show updated slides
                // This is simpler for edit view than rebuilding the grid
                setTimeout(() => {
                    location.reload();
                }, 500);
            }
        });
    </script>
{% endblock %}
