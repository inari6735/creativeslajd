{% extends 'base.html.twig' %}

{% block title %}Logowanie - CreativeSlajd{% endblock %}

{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <img src="{{ asset('images/cs-logo.png') }}" alt="CS Logo" class="auth-logo">
            <h1><span class="brand-creative">Creative</span><span class="brand-slajd">Slajd</span></h1>
            <p class="auth-subtitle">Zaloguj się do swojego konta</p>
        </div>

        {% if error %}
            <div class="alert alert-error">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <div class="form-group">
                <label for="username">Email</label>
                <input type="email" 
                       value="{{ last_username }}" 
                       name="_username" 
                       id="username" 
                       class="form-control" 
                       autocomplete="email" 
                       placeholder="twoj@email.com"
                       required 
                       autofocus>
            </div>

            <div class="form-group">
                <label for="password">Hasło</label>
                <input type="password" 
                       name="_password" 
                       id="password" 
                       class="form-control" 
                       autocomplete="current-password" 
                       placeholder="••••••••"
                       required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn btn-primary btn-block btn-lg">Zaloguj się</button>
        </form>

        <div class="auth-footer">
            <p>Nie masz jeszcze konta? <a href="{{ path('app_register') }}" class="auth-link">Zarejestruj się</a></p>
        </div>
    </div>
</div>
{% endblock %}
